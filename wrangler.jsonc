{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mountain-huts-map",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"]
  // Visits ("chi c'è stato"): code is in place, the D1 binding is NOT enabled yet
  // because it needs a real database_id. After `wrangler d1 create`, add:
  //   "d1_databases": [
  //     { "binding": "DB", "database_name": "mountain-huts-visits",
  //       "database_id": "<id printed by wrangler d1 create>", "migrations_dir": "migrations" }
  //   ]
  // Secrets (never in this file): IP_SALT, MODERATION_TOKEN via `wrangler secret put <NAME>`.
  // Local dev secrets go in .dev.vars (gitignored). See README "Visits (chi c'è stato)".
}
