{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hut",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "no": {
          "type": "string"
        },
        "de": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "bivacco",
        "rifugio"
      ]
    },
    "osm_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_level": {
      "type": "string",
      "enum": [
        "staffed",
        "self_service",
        "unstaffed",
        "unknown"
      ]
    },
    "category_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "coords": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false
    },
    "elevation_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "province": {
          "type": [
            "string",
            "null"
          ]
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ]
        },
        "mountain_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_peak": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ele": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "distance_m": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "ele",
                "distance_m"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "country",
        "region",
        "province",
        "municipality",
        "mountain_group",
        "nearest_peak"
      ],
      "additionalProperties": false
    },
    "capacity": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "price": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "free"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paid"
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "night_from": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "night_to": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "half_board_from": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "cai_member_discount": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_on": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "currency",
            "night_from",
            "night_to",
            "half_board_from",
            "cai_member_discount",
            "source_url",
            "checked_on"
          ],
          "additionalProperties": false
        }
      ]
    },
    "facilities": {
      "type": "object",
      "properties": {
        "fireplace": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stove": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "drinking_water": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "blankets": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "toilet": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "winter_room": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "fireplace",
        "stove",
        "drinking_water",
        "blankets",
        "toilet",
        "winter_room"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "opening_hours": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_note_it": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_note_en": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "opening_hours",
        "access_note_it",
        "access_note_en"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "phone",
        "email",
        "website"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "it": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "it",
        "en"
      ],
      "additionalProperties": false
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "thumb_url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url",
          "thumb_url",
          "author",
          "license",
          "source_url"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "wikipedia",
              "official",
              "cai",
              "osm",
              "other"
            ]
          }
        },
        "required": [
          "label",
          "url",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "name",
          "url",
          "fetched_at"
        ],
        "additionalProperties": false
      }
    },
    "verified": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "names",
    "category",
    "osm_type",
    "service_level",
    "category_confidence",
    "coords",
    "elevation_m",
    "location",
    "capacity",
    "price",
    "facilities",
    "access",
    "contact",
    "description",
    "photos",
    "links",
    "sources",
    "verified",
    "updated_at"
  ],
  "additionalProperties": false
}
