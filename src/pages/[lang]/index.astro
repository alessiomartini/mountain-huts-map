---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterPanel from '../../components/FilterPanel.astro';
import HutCardTemplate from '../../components/HutCardTemplate.astro';
import { getLangStaticPaths, useTranslations, type Lang } from '../../i18n/index.ts';
import { hutsToFeatureCollection } from '../../lib/geojson.ts';
import huts from '../../data/huts.json';
import type { Hut } from '../../lib/hut-schema.ts';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const typedHuts = huts as Hut[];
const featureCollection = hutsToFeatureCollection(typedHuts, lang);
---

<BaseLayout lang={lang} title={t('site.title')} description={t('site.tagline')}>
  <div class="map-page">
    <FilterPanel lang={lang} huts={typedHuts} />

    <div id="map-container" class="map-container"></div>

    <div class="map-style-switcher" role="group" aria-label={t('map.layers.title')}>
      <button type="button" data-map-style="standard" class="is-active">{t('map.layers.standard')}</button>
      <button type="button" data-map-style="topo">{t('map.layers.topo')}</button>
    </div>

    <button type="button" id="map-legend-toggle" class="map-legend-toggle" aria-expanded="false" aria-controls="map-legend">
      ℹ️ {t('map.legend.toggle')}
    </button>
    <div id="map-legend" class="map-legend" hidden>
      <h3>{t('map.legend.title')}</h3>
      <ul class="map-legend__pins">
        <li><span class="map-legend__swatch map-legend__swatch--rifugio" aria-hidden="true"></span>{t('map.legend.pinRifugio')}</li>
        <li><span class="map-legend__swatch map-legend__swatch--bivacco" aria-hidden="true"></span>{t('map.legend.pinBivacco')}</li>
      </ul>
      <ul data-legend-for="standard">
        <li><span class="map-legend__color" style="background:#a8d5a2" aria-hidden="true"></span>{t('map.legend.standard.greenDark')}</li>
        <li><span class="map-legend__color" style="background:#d7ecd2" aria-hidden="true"></span>{t('map.legend.standard.greenLight')}</li>
        <li><span class="map-legend__color" style="background:#f2f2ee;border:1px solid #ccc" aria-hidden="true"></span>{t('map.legend.standard.white')}</li>
        <li><span class="map-legend__color" style="background:#a9cbe8" aria-hidden="true"></span>{t('map.legend.standard.water')}</li>
      </ul>
      <ul data-legend-for="topo" hidden>
        <li><span class="map-legend__color" style="background:#8dc98d" aria-hidden="true"></span>{t('map.legend.topo.green')}</li>
        <li><span class="map-legend__color" style="background:#a3712a" aria-hidden="true"></span>{t('map.legend.topo.contours')}</li>
        <li><span class="map-legend__color" style="background:#f5f5f0;border:1px solid #ccc" aria-hidden="true"></span>{t('map.legend.topo.white')}</li>
        <li><span class="map-legend__color" style="background:#8ec7e0" aria-hidden="true"></span>{t('map.legend.topo.water')}</li>
        <li><span class="map-legend__dashed" aria-hidden="true"></span>{t('map.legend.topo.borders')}</li>
      </ul>
    </div>

    <div id="hut-bottom-sheet" class="hut-bottom-sheet" hidden>
      <button type="button" id="hut-bottom-sheet-close" class="hut-bottom-sheet__close" aria-label={t('common.close')}>✕</button>
      <div id="hut-bottom-sheet-content"></div>
    </div>
  </div>

  <div hidden>
    {typedHuts.map((hut) => <HutCardTemplate lang={lang} hut={hut} />)}
  </div>

  <script
    is:inline
    define:vars={{
      featureCollection,
      lang,
      resultsCountTemplate: t('map.filters.resultsCount'),
      nearMeErrorMessage: t('map.filters.nearMeError'),
    }}
  >
    window.__HUTS_MAP_INIT__ = { featureCollection, lang, resultsCountTemplate, nearMeErrorMessage };
  </script>
  <script>
    import { initHutsMapFromGlobal } from '../../scripts/map-client.ts';
    initHutsMapFromGlobal();
  </script>
</BaseLayout>

<style>
  .map-page {
    position: relative;
    height: calc(100vh - var(--header-height));
  }
  .map-container {
    position: absolute;
    inset: 0;
  }
  .map-style-switcher {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .map-style-switcher button {
    padding: 0.5rem 1rem;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.85rem;
  }
  .map-style-switcher button.is-active {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .hut-bottom-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-surface);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    box-shadow: var(--shadow-card);
    z-index: 30;
    transform: translateY(100%);
    transition: transform 0.2s ease;
    max-height: 70vh;
    overflow-y: auto;
    padding: 0.5rem;
  }
  .hut-bottom-sheet.is-open {
    transform: translateY(0);
  }
  .hut-bottom-sheet__close {
    background: none;
    border: none;
    font-size: 1.1rem;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--color-text);
    min-width: 44px;
    min-height: 44px;
  }
  .map-legend-toggle {
    position: absolute;
    bottom: 1.5rem;
    right: 1rem;
    z-index: 20;
    padding: 0.5rem 0.9rem;
    border: none;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    font-size: 0.85rem;
  }
  .map-legend {
    position: absolute;
    bottom: 4rem;
    right: 1rem;
    z-index: 20;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 0.85rem 1rem;
    max-width: 260px;
    font-size: 0.82rem;
  }
  .map-legend h3 {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .map-legend ul {
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .map-legend ul:last-child {
    margin-bottom: 0;
  }
  .map-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
  }
  .map-legend__pins li {
    color: var(--color-text);
    font-weight: 500;
  }
  .map-legend__swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .map-legend__swatch--rifugio {
    background: var(--color-rifugio);
  }
  .map-legend__swatch--bivacco {
    background: var(--color-bivacco);
  }
  .map-legend__color {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .map-legend__dashed {
    width: 0.85rem;
    height: 0;
    border-top: 2px dashed #c0392b;
    flex-shrink: 0;
  }

  .user-location-marker {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #1663c7;
    border: 3px solid white;
    box-shadow: 0 0 0 2px #1663c7;
  }
</style>
