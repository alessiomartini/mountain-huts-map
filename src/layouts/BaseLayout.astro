---
import '../styles/global.css';
import LangSwitcher from '../components/LangSwitcher.astro';
import SafetyDisclaimer from '../components/SafetyDisclaimer.astro';
import { LANGS, getRouteForLang, useTranslations, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogImage?: string;
}
const { lang, title, description, ogImage } = Astro.props;
const t = useTranslations(lang);
const siteUrl = Astro.site ?? new URL('https://mountain-huts-map.workers.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      LANGS.map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(getRouteForLang(Astro.url, code), siteUrl)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(getRouteForLang(Astro.url, 'it'), siteUrl)} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <script is:inline>
      // Apply the stored light/dark choice before first paint (no flash).
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>

    <div class="page">
      <header class="site-header">
        <a href={`/${lang}/`} class="site-header__brand">{t('site.title')}</a>
        <nav aria-label="Main" class="site-header__nav">
          <a href={`/${lang}/`}>{t('nav.map')}</a>
          <a href={`/${lang}/list`}>{t('nav.list')}</a>
          <a href={`/${lang}/about`}>{t('nav.about')}</a>
        </nav>
        <button
          type="button"
          class="theme-btn"
          data-to-light={t('theme.toLight')}
          data-to-dark={t('theme.toDark')}
          aria-label={t('theme.toDark')}>
          ☾
        </button>
        <LangSwitcher lang={lang} />
      </header>

      <main id="main" class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <p class="site-footer__osm">
          {t('footer.osmAttribution')} · <a href={`/${lang}/attribution`}>{t('footer.attributionLink')}</a>
        </p>
        <SafetyDisclaimer lang={lang} />
      </footer>
    </div>
    <script is:inline>
      // Light/dark toggle: default follows the system, the button stores a choice.
      (() => {
        const root = document.documentElement;
        const btns = document.querySelectorAll('.theme-btn');
        const media = matchMedia('(prefers-color-scheme: dark)');
        const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : media.matches);
        const label = () =>
          btns.forEach((b) => {
            b.textContent = isDark() ? '☀' : '☾';
            b.title = isDark() ? b.dataset.toLight : b.dataset.toDark;
            b.setAttribute('aria-label', b.title);
          });
        label();
        media.addEventListener('change', label);
        btns.forEach((b) =>
          b.addEventListener('click', () => {
            root.dataset.theme = isDark() ? 'light' : 'dark';
            try {
              localStorage.setItem('theme', root.dataset.theme);
            } catch {}
            label();
          }),
        );
      })();
    </script>
  </body>
</html>

<style is:global>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1rem;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    gap: 1rem;
    flex: 1;
    font-size: 0.9rem;
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-text);
  }

  .theme-btn {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
    padding: 0.3rem 0.55rem;
  }
  .theme-btn:hover {
    border-color: var(--color-text-muted);
  }

  .site-main {
    flex: 1;
    min-height: 0;
  }

  .site-footer {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  .site-footer__osm {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 480px) {
    :root {
      --header-height: 92px;
    }
    .site-header {
      flex-wrap: wrap;
      align-content: center;
      padding: 0.4rem 0.5rem;
      gap: 0.3rem 0.5rem;
    }
    .site-header__brand {
      font-size: 0.85rem;
    }
    .site-header__nav {
      flex-basis: 100%;
      order: 3;
      gap: 0.6rem;
      font-size: 0.8rem;
    }
  }
</style>
