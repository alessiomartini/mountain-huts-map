---
import { useTranslations, type Lang } from '../i18n/index.ts';
import type { Hut } from '../lib/hut-schema.ts';

interface Props {
  lang: Lang;
  huts: Hut[];
}
const { lang, huts } = Astro.props;
const t = useTranslations(lang);

const regionsByCountry = new Map<string, Set<string>>();
for (const hut of huts) {
  if (!hut.location.region) continue;
  const set = regionsByCountry.get(hut.location.country) ?? new Set<string>();
  set.add(hut.location.region);
  regionsByCountry.set(hut.location.country, set);
}
const countries = [...new Set(huts.map((h) => h.location.country))].sort();
const regions = [...new Set(huts.map((h) => h.location.region).filter((r): r is string => !!r))].sort();

const elevations = huts.map((h) => h.elevation_m).filter((e): e is number => e != null);
const minElevation = elevations.length ? Math.min(...elevations) : 0;
const maxElevation = elevations.length ? Math.max(...elevations) : 4000;
---

<aside class="filter-panel" id="filter-panel">
  <div class="filter-panel__header">
    <h2>{t('map.filters.title')}</h2>
    <button type="button" id="filter-panel-close" class="filter-panel__close" aria-label={t('common.close')}>✕</button>
  </div>

  <div class="filter-group">
    <span class="filter-group__label" id="filter-type-label">{t('map.filters.type')}</span>
    <div class="filter-chip-group" role="group" aria-labelledby="filter-type-label">
      <label class="filter-chip filter-chip--bivacco">
        <input type="checkbox" name="type" value="bivacco" checked data-filter="type" />
        <span class="filter-chip__dot" aria-hidden="true"></span>
        {t('map.filters.bivacchi')}
      </label>
      <label class="filter-chip filter-chip--rifugio">
        <input type="checkbox" name="type" value="rifugio" data-filter="type" />
        <span class="filter-chip__dot" aria-hidden="true"></span>
        {t('map.filters.rifugi')}
      </label>
    </div>
  </div>

  <div class="filter-group">
    <label for="filter-search" class="filter-group__label">{t('map.filters.search')}</label>
    <div class="filter-input-wrap">
      <span class="filter-input-wrap__icon" aria-hidden="true">🔍</span>
      <input type="search" id="filter-search" data-filter="search" placeholder={t('map.filters.searchPlaceholder')} />
    </div>
  </div>

  <div class="filter-group">
    <span class="filter-group__label" id="filter-altitude-label">{t('map.filters.altitude')}</span>
    <div class="filter-altitude">
      <input type="number" id="filter-alt-min" data-filter="alt-min" min={minElevation} max={maxElevation} value={minElevation} aria-label={`${t('map.filters.altitude')} min`} />
      <span class="filter-altitude__sep" aria-hidden="true">–</span>
      <input type="number" id="filter-alt-max" data-filter="alt-max" min={minElevation} max={maxElevation} value={maxElevation} aria-label={`${t('map.filters.altitude')} max`} />
      <span class="filter-altitude__unit">m</span>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-chip-group">
      <label class="filter-chip">
        <input type="checkbox" id="filter-free-only" data-filter="free-only" />
        {t('map.filters.priceOnlyFree')}
      </label>
    </div>
  </div>

  <div class="filter-group">
    <span class="filter-group__label">{t('map.filters.facilities')}</span>
    <div class="filter-chip-group">
      <label class="filter-chip">
        <input type="checkbox" name="fac" value="drinking_water" data-filter="facility" />
        {t('map.filters.facility.drinking_water')}
      </label>
      <label class="filter-chip">
        <input type="checkbox" name="fac" value="stove" data-filter="facility" />
        {t('map.filters.facility.stove')}
      </label>
      <label class="filter-chip">
        <input type="checkbox" name="fac" value="winter_room" data-filter="facility" />
        {t('map.filters.facility.winter_room')}
      </label>
      <label class="filter-chip">
        <input type="checkbox" name="fac" value="blankets" data-filter="facility" />
        {t('map.filters.facility.blankets')}
      </label>
    </div>
  </div>

  <div class="filter-group">
    <label for="filter-country" class="filter-group__label">{t('map.filters.areaCountry')}</label>
    <select id="filter-country" data-filter="country">
      <option value="">{t('map.filters.areaAny')}</option>
      {countries.map((c) => <option value={c}>{c}</option>)}
    </select>
    <label for="filter-region" class="filter-group__label">{t('map.filters.areaRegion')}</label>
    <select id="filter-region" data-filter="region">
      <option value="">{t('map.filters.areaAny')}</option>
      {regions.map((r) => <option value={r}>{r}</option>)}
    </select>
  </div>

  <button type="button" id="filter-near-me" class="filter-near-me">📍 {t('map.filters.nearMe')}</button>

  <div class="filter-footer">
    <p id="filter-results-count" class="filter-results-count" aria-live="polite"></p>
    <button type="button" id="filter-reset" class="filter-reset">{t('map.filters.reset')}</button>
  </div>

  <script is:inline type="application/json" id="region-by-country-data" set:html={JSON.stringify(Object.fromEntries([...regionsByCountry].map(([k, v]) => [k, [...v].sort()])))} />
</aside>

<button type="button" id="filter-panel-open" class="filter-panel__open" aria-expanded="false" aria-controls="filter-panel">
  ☰ {t('map.filters.title')}
</button>

<style>
  .filter-panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    padding: 1rem;
    overflow-y: auto;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filter-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .filter-panel__header h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .filter-panel__close {
    display: none;
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--color-text);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .filter-group__label {
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  /* Pill-style chips replace plain checkboxes for type/facilities/free-only —
     the input stays in the DOM (visually hidden) so map-client.ts's existing
     `input[data-filter=...]` queries keep working unchanged; :has() drives
     the checked look. */
  .filter-chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .filter-chip:hover {
    border-color: var(--color-text-muted);
  }
  .filter-chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .filter-chip:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .filter-chip__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .filter-chip--bivacco .filter-chip__dot {
    background: var(--color-bivacco);
  }
  .filter-chip--rifugio .filter-chip__dot {
    background: var(--color-rifugio);
  }
  /* Non-type chips (facilities, free-only) use the general accent when checked */
  .filter-chip:not(.filter-chip--bivacco):not(.filter-chip--rifugio):has(input:checked) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  /* Type chips take on their own marker color when checked, so the toggle
     visually matches the pins it filters on the map. */
  .filter-chip--bivacco:has(input:checked) {
    background: var(--color-bivacco);
    border-color: var(--color-bivacco);
    color: var(--color-primary-contrast);
  }
  .filter-chip--rifugio:has(input:checked) {
    background: var(--color-rifugio);
    border-color: var(--color-rifugio);
    color: var(--color-primary-contrast);
  }
  .filter-chip--bivacco:has(input:checked) .filter-chip__dot,
  .filter-chip--rifugio:has(input:checked) .filter-chip__dot {
    background: var(--color-primary-contrast);
  }

  .filter-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .filter-input-wrap__icon {
    position: absolute;
    left: 0.7rem;
    font-size: 0.85rem;
    opacity: 0.6;
    pointer-events: none;
  }
  .filter-input-wrap input[type='search'] {
    width: 100%;
    padding-left: 2rem;
  }

  .filter-altitude {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.6rem;
  }
  .filter-altitude input {
    width: 4.5rem;
    border: none !important;
    padding: 0.15rem !important;
    text-align: center;
  }
  .filter-altitude__sep {
    color: var(--color-text-muted);
  }
  .filter-altitude__unit {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  select,
  input[type='search'],
  input[type='number'] {
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.9rem;
  }
  select:focus-visible,
  input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }

  .filter-near-me,
  .filter-reset {
    padding: 0.55rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .filter-near-me {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-near-me:hover {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .filter-reset:hover {
    border-color: var(--color-text-muted);
  }

  .filter-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .filter-results-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .filter-panel__open {
    display: none;
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 700px) {
    .filter-panel {
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      width: 85vw;
      box-shadow: var(--shadow-card);
    }
    .filter-panel.is-open {
      transform: translateX(0);
    }
    .filter-panel__close {
      display: block;
    }
    .filter-panel__open {
      display: block;
    }
  }
</style>

<script>
  const panel = document.getElementById('filter-panel')!;
  const openBtn = document.getElementById('filter-panel-open')!;
  const closeBtn = document.getElementById('filter-panel-close')!;
  openBtn.addEventListener('click', () => {
    panel.classList.add('is-open');
    openBtn.setAttribute('aria-expanded', 'true');
  });
  closeBtn.addEventListener('click', () => {
    panel.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
  });

  const countrySelect = document.getElementById('filter-country') as HTMLSelectElement;
  const regionSelect = document.getElementById('filter-region') as HTMLSelectElement;
  const regionByCountry = JSON.parse(document.getElementById('region-by-country-data')!.textContent || '{}') as Record<string, string[]>;
  const allRegionOptions = [...regionSelect.options].map((o) => ({ value: o.value, label: o.textContent ?? '' }));

  countrySelect.addEventListener('change', () => {
    const allowed = countrySelect.value ? new Set(regionByCountry[countrySelect.value] ?? []) : null;
    const current = regionSelect.value;
    regionSelect.innerHTML = '';
    for (const opt of allRegionOptions) {
      if (opt.value !== '' && allowed && !allowed.has(opt.value)) continue;
      const el = document.createElement('option');
      el.value = opt.value;
      el.textContent = opt.label;
      regionSelect.appendChild(el);
    }
    if ([...regionSelect.options].some((o) => o.value === current)) regionSelect.value = current;
    regionSelect.dispatchEvent(new Event('change'));
  });
</script>
